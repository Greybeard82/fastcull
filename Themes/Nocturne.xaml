<?xml version="1.0" encoding="utf-8"?>
<!--
    Nocturne design-system tokens, from the Design/ handoff ("Chromeless", look 1b).

    These are the literal token values, not re-derived approximations - the handoff is explicit
    that the numbers are final rather than placeholders. Anything that needs a colour, size or
    radius in the culling stage should reference a key here rather than inlining a hex value,
    so a token change lands in one place.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Ground ============================ -->

    <!-- PRD 1.10: the window ground is exactly #FF000000 so the pixels are fully off on OLED.
         The handoff agrees on this one deliberately ("not a Nocturne-ground tint"). -->
    <Color x:Key="GroundColor">#FF000000</Color>
    <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource GroundColor}"/>

    <!--
        The filmstrip band. The handoff asks for the ground mixed ~18% toward black, which works
        out to #0E101B - a near-black, not black.

        PRD 1.10 rules that out by name: "every pixel that is not photograph content is
        #FF000000 ... this includes ... filmstrip card backgrounds. Near-blacks such as #0A0A0A
        do NOT satisfy this requirement." Since CLAUDE.md makes the PRD the source of truth, the
        band ships pure black and the handoff's tint is recorded here instead of applied.

        To adopt the handoff value instead, change this one brush to #FF0E101B. Nothing else
        needs to move.
    -->
    <SolidColorBrush x:Key="FilmstripBandBrush" Color="#FF000000"/>
    <Color x:Key="FilmstripBandHandoffColor">#FF0E101B</Color>

    <!-- ========================== Neutral ramp ========================= -->

    <SolidColorBrush x:Key="Neutral100Brush" Color="#FFF3F5FE"/>
    <SolidColorBrush x:Key="Neutral200Brush" Color="#FFE4E7F5"/>
    <SolidColorBrush x:Key="Neutral300Brush" Color="#FFCFD3E5"/>
    <SolidColorBrush x:Key="Neutral400Brush" Color="#FFB2B6CA"/>
    <SolidColorBrush x:Key="Neutral500Brush" Color="#FF9397AB"/>
    <SolidColorBrush x:Key="Neutral600Brush" Color="#FF75798C"/>
    <SolidColorBrush x:Key="Neutral700Brush" Color="#FF595D6C"/>
    <SolidColorBrush x:Key="Neutral800Brush" Color="#FF3F424D"/>
    <SolidColorBrush x:Key="Neutral900Brush" Color="#FF292B31"/>

    <!-- =========================== Accent ramp ========================= -->

    <Color x:Key="AccentColor">#FF9184D9</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent200Brush" Color="#FFE7E5FE"/>
    <SolidColorBrush x:Key="Accent300Brush" Color="#FFD2CEFD"/>
    <SolidColorBrush x:Key="Accent400Brush" Color="#FFB5ABFC"/>

    <SolidColorBrush x:Key="TextBrush" Color="#FFE9E9ED"/>

    <!-- ======================== Flag marks ============================
         Outside the ramp on purpose: Nocturne is mono-accent and carries no semantic
         green/red. The handoff documents these two as a deliberate exception and asks that
         the palette not be extended further. -->
    <SolidColorBrush x:Key="PickBrush" Color="#FF7FAE8E"/>
    <SolidColorBrush x:Key="RejectBrush" Color="#FFB8756B"/>

    <!-- ========================= Typography ===========================
         Inter throughout. The fallback chain matters: Inter is not a stock Windows font, and
         without a fallback WinUI silently substitutes a default that breaks the tracking. -->
    <FontFamily x:Key="UiFontFamily">Inter, Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- ==================== Spacing (0.7x density) ===================== -->

    <x:Double x:Key="Space1">2.8</x:Double>
    <x:Double x:Key="Space2">5.6</x:Double>
    <x:Double x:Key="Space3">8.4</x:Double>
    <x:Double x:Key="Space4">11.2</x:Double>
    <x:Double x:Key="Space6">16.8</x:Double>
    <x:Double x:Key="Space8">22.4</x:Double>

    <!-- ========================= Stage geometry ========================
         Tuned for maximum photo real estate: the three photos sit almost edge to edge and
         the stage runs nearly the full window width. Vertical padding is deliberately NOT
         squeezed - it carries the accent tick above each photo and the weight bar plus
         caption below, which is the entire state read in the Chromeless look.

         These are the single definition. Views/FilmstripView.xaml applies them, and the
         code-behind reads the applied ColumnSpacing back off the Grid rather than keeping
         its own copy, so the equal-height rule can never be computed against a spacing
         that no longer exists. -->

    <x:Double x:Key="StageColumnSpacing">5</x:Double>
    <Thickness x:Key="StagePadding">8,18,8,24</Thickness>

    <!-- ====================== Chromeless glyph button ==================
         A flat, borderless glyph button for the rotate controls.

         The stock WinUI Button template is unusable here: its resting, hover and pressed
         visual states all paint near-black greys, and PRD 1.10 requires every non-photograph
         pixel to be exactly #FF000000. This template never paints a background in ANY state -
         Transparent over the black ground stays exactly #FF000000 - and expresses state
         purely as glyph brightness, which also matches the Chromeless language of restraint.

         IsTabStop is off: keyboard is owned at window level by RootGrid_PreviewKeyDown
         (PRD 2.4), and a focusable button in the caption row could take Space/Enter. -->
    <Style x:Key="ChromelessGlyphButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource Neutral600Brush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Presenter"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{StaticResource Accent200Brush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{StaticResource AccentBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Opacity" Value="0.35"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Radius ============================= -->

    <CornerRadius x:Key="RadiusPhoto">2</CornerRadius>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>

</ResourceDictionary>
