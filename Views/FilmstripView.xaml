<UserControl
    x:Class="Fastcull.Views.FilmstripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fastcull.Views"
    xmlns:vm="using:Fastcull.ViewModels"
    xmlns:conv="using:Fastcull.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    FontFamily="{StaticResource UiFontFamily}"
    Loaded="FilmstripView_Loaded">

    <!--
        The "Chromeless" direction from the Design/ handoff (look 1b): no borders anywhere.
        State reads as a 3px weight bar beneath each photo, active-ness as a thin accent tick
        above it. The photos carry the screen; the interface gets out of the way.

        The concentric red/yellow/green + blue rings that PRD 1.5 describes are deliberately
        gone - that section describes the earlier visual pass, and this handoff is the direction
        that was picked from three explored looks.
    -->
    <UserControl.Resources>
        <conv:CullStateToWeightBarBrushConverter x:Key="WeightBrush"/>
        <conv:ThumbnailMarkBrushConverter x:Key="ThumbMark"/>
        <conv:BoolToThumbnailOpacityConverter x:Key="ThumbOpacity"/>
        <conv:BoolToAccentBrushConverter x:Key="AccentIfActive"/>
        <conv:BoolToCaptionBrushConverter x:Key="CaptionBrush"/>
        <conv:BoolToVisibilityConverter x:Key="VisibleIfActive"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto" Background="{StaticResource GroundBrush}">

        <!-- ================================ STAGE ================================
             As many consecutive photos as actually fit (PRD 1.5), the active one centred
             except at the sequence ends.

             StageHost owns the available space; the repeater sizes to its content and
             centres inside it. Nothing here gets a fixed share of the width: each slot is
             exactly as wide as its photo, so the only horizontal space between photos is
             the real spacing. With fixed thirds a portrait photo sat in a landscape-sized
             cell and the gap became hundreds of pixels while the spacing said 5.

             The count is variable, so this is a templated repeater rather than hand-written
             slots, and every dimension is bound from the item rather than assigned to an
             x:Name'd element - ItemsRepeater does not propagate DataContext to realized
             containers under x:Bind, so binding is the path that works. -->
        <Border x:Name="StageHost" Grid.Row="0" Padding="{StaticResource StagePadding}"
                SizeChanged="StageHost_SizeChanged">

            <!-- StageSlide carries the navigation transition. It paints no background, so it
                 adds no non-black pixels over the stage (PRD 1.10). -->
            <Grid x:Name="StageSlide" HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <!-- Scale carries the zoom, translate carries the navigation slide. Both settle
                     at identity, and RenderTransformOrigin above puts the scale's centre at the
                     stage's centre. -->
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="StageZoomTransform"/>
                        <TranslateTransform x:Name="StageSlideTransform"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <ItemsRepeater x:Name="StageRepeater" ItemsSource="{x:Bind ViewModel.StageItems}"
                               IsTabStop="False" VerticalAlignment="Center">
                    <ItemsRepeater.Layout>
                        <StackLayout x:Name="StageStack" Orientation="Horizontal"
                                     Spacing="{StaticResource StageColumnSpacing}"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilmstripItemViewModel">
                            <StackPanel Spacing="12" Background="Transparent"
                                        Tapped="Slot_Tapped"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">

                                <!-- Accent tick: only above the active photo, 18% of its width. -->
                                <Border Height="2" CornerRadius="1" Margin="0,0,0,2"
                                        HorizontalAlignment="Center"
                                        Width="{x:Bind StageTickWidth, Mode=OneWay}"
                                        Visibility="{x:Bind StageChromeVisibility, Mode=OneWay}"
                                        Background="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource AccentIfActive}}"/>

                                <!-- Frame is the POST-rotation layout box; the Image inside is
                                     laid out pre-rotation and turned about its centre. The Image
                                     sits in a Canvas because every other panel clamps a child's
                                     DesiredSize to the space available, which crushes the swapped
                                     dimension on a quarter turn. -->
                                <Grid x:Name="StageFrame"
                                      Width="{x:Bind StageFrameWidth, Mode=OneWay}"
                                      Height="{x:Bind StageFrameHeight, Mode=OneWay}">
                                    <Canvas>
                                        <Image x:Name="StagePhoto" Stretch="Uniform"
                                               Source="{x:Bind StageImageSource, Mode=OneWay}"
                                               Width="{x:Bind StageImageWidth, Mode=OneWay}"
                                               Height="{x:Bind StageImageHeight, Mode=OneWay}"
                                               Canvas.Left="{x:Bind StageImageLeft, Mode=OneWay}"
                                               Canvas.Top="{x:Bind StageImageTop, Mode=OneWay}"
                                               RenderTransformOrigin="0.5,0.5">
                                            <!-- Two rotations about the same centre, so they
                                                 simply add. The first is the settled angle and
                                                 changes instantly with the state; the second is
                                                 the animated delta, which starts at the opposite
                                                 of the turn just taken and sweeps to zero. Net
                                                 effect: the photo appears to turn from where it
                                                 was to where it already is. Same shape as the
                                                 navigation slide, which also settles at zero. -->
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform Angle="{x:Bind RotationAngle, Mode=OneWay}"/>
                                                    <RotateTransform/>
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Canvas>
                                    <TextBlock Text="&#x26A0;" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource RejectBrush}"
                                               Visibility="{x:Bind DisplayImageFailedVisibility, Mode=OneWay}"/>

                                    <!-- Rating indicators, drawn ON the photo so they are present
                                         in the stage, while zoomed, and (scaled down) on the
                                         thumbnails. Transparent when unflagged, so an unrated
                                         photo carries no mark at all. -->
                                    <Border Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                            Background="{x:Bind CullState, Mode=OneWay, Converter={StaticResource ThumbMark}}"/>

                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,10,14" CornerRadius="4" Padding="8,1"
                                            Background="#B0000000"
                                            Visibility="{x:Bind IsStarBadgeVisible, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind StarBadgeText, Mode=OneWay}"
                                                   FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>

                                    <!-- PRD 3.3: say so when the dimension guard capped this
                                         photo, rather than letting it look mysteriously soft. -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="10,10,0,0" CornerRadius="4" Padding="8,2"
                                            Background="#B0000000"
                                            Visibility="{x:Bind DimensionLimitedVisibility, Mode=OneWay}">
                                        <TextBlock Text="1:1 UNAVAILABLE — IMAGE TOO LARGE"
                                                   FontSize="10" CharacterSpacing="120"
                                                   Foreground="{StaticResource Neutral300Brush}"/>
                                    </Border>
                                </Grid>

                                <!-- The Chromeless weight bar that used to sit here, below the
                                     photo, is gone: the flag bar now renders on the photo itself
                                     and two bars an inch apart read as a mistake. -->

                                <!-- Caption row. Its height is FIXED and identical in every slot:
                                     the rotate buttons are taller than the 10px caption text, so
                                     letting them grow this row made the active slot taller than
                                     its neighbours and, with VerticalAlignment=Center, pushed its
                                     photo up by half the excess. CaptionHeight in the code-behind
                                     must match StageCaptionHeight here or the shared-height
                                     computation works from a stale number. -->
                                <Grid HorizontalAlignment="Stretch"
                                      Height="{StaticResource StageCaptionHeight}"
                                      Visibility="{x:Bind StageChromeVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                   FontSize="10" CharacterSpacing="140"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource CaptionBrush}}"/>
                                    </StackPanel>

                                    <!-- Rotate controls (PRD 1.11). They render in the ACTIVE
                                         slot, wherever that is - which at the first and last
                                         photo of the sequence is an end slot, not the centre. -->
                                    <StackPanel Orientation="Horizontal" Spacing="2"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Tapped="RotateButtons_Tapped"
                                                Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource VisibleIfActive}}">
                                        <Button Style="{StaticResource ChromelessGlyphButtonStyle}"
                                                Content="&#x21BA;" Click="RotateLeft_Click"
                                                AutomationProperties.Name="Rotate left 90 degrees"/>
                                        <Button Style="{StaticResource ChromelessGlyphButtonStyle}"
                                                Content="&#x21BB;" Click="RotateRight_Click"
                                                AutomationProperties.Name="Rotate right 90 degrees"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Border>

        <!-- ============================== FILMSTRIP ==============================
             108px band, one step darker than the window in the handoff - see
             Themes/Nocturne.xaml for why it ships pure black instead. Mouse-only
             (PRD 2.4): it never sees arrow keys, and scrolling here never moves the
             stage selection. Only a click does. -->
        <Grid Grid.Row="1" Height="108" Background="{StaticResource FilmstripBandBrush}"
              BorderThickness="0,1,0,0" BorderBrush="{StaticResource Neutral900Brush}"
              Visibility="{x:Bind ViewModel.IsZoomed, Mode=OneWay, Converter={StaticResource HiddenIfZoomed}}">

            <ScrollViewer x:Name="BottomScroll" Padding="0,8"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                          ZoomMode="Disabled"
                          IsTabStop="False" XYFocusKeyboardNavigation="Disabled"
                          PointerWheelChanged="BottomScroll_PointerWheelChanged"
                          PointerPressed="BottomScroll_PointerPressed"
                          PointerMoved="BottomScroll_PointerMoved"
                          PointerReleased="BottomScroll_PointerReleased"
                          PointerCaptureLost="BottomScroll_PointerReleased">
                <!-- Thumbnails decode when the repeater realizes a container and cancel when it
                     recycles one, so a 2,000-photo folder only ever decodes the dozen or so
                     actually on screen rather than all of them at startup. -->
                <ItemsRepeater x:Name="ThumbRepeater" ItemsSource="{x:Bind ViewModel.Items}" IsTabStop="False"
                               Margin="40,0" VerticalAlignment="Bottom"
                               ElementPrepared="ThumbRepeater_ElementPrepared"
                               ElementClearing="ThumbRepeater_ElementClearing">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="8"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilmstripItemViewModel">
                            <StackPanel Width="150" VerticalAlignment="Bottom"
                                        Tapped="Thumbnail_Tapped" Background="Transparent"
                                        Opacity="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource ThumbOpacity}}">
                                <!-- UniformToFill + a corner-radius Border reproduces the
                                     handoff's background-size: cover crop. -->
                                <!-- The Border is the slot and clips to it. The Image inside is
                                     laid out with width/height swapped on a quarter turn, so
                                     once rotated about its centre its bounding box is exactly
                                     the slot - a rotated thumbnail fills its slot and never
                                     overlaps its neighbours. -->
                                <Border CornerRadius="2" Height="{x:Bind ThumbnailSlotHeight, Mode=OneWay}">
                                    <Grid>
                                        <Canvas>
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                                                   Width="{x:Bind ThumbnailImageWidth, Mode=OneWay}"
                                                   Height="{x:Bind ThumbnailImageHeight, Mode=OneWay}"
                                                   Canvas.Left="{x:Bind ThumbnailImageLeft, Mode=OneWay}"
                                                   Canvas.Top="{x:Bind ThumbnailImageTop, Mode=OneWay}"
                                                   RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <RotateTransform Angle="{x:Bind RotationAngle, Mode=OneWay}"/>
                                                </Image.RenderTransform>
                                            </Image>
                                        </Canvas>
                                        <TextBlock Text="&#x26A0;" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource RejectBrush}"
                                                   Visibility="{x:Bind ThumbnailFailedVisibility, Mode=OneWay}"/>

                                        <!-- Same two indicators as the stage, scaled to a 150px
                                             slot: a 3px bar rather than 6, and a 10px badge that
                                             stays legible without dominating the thumbnail. -->
                                        <Border Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                                Background="{x:Bind CullState, Mode=OneWay, Converter={StaticResource ThumbMark}}"/>

                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,4,6" CornerRadius="3" Padding="4,0"
                                                Background="#B0000000"
                                                Visibility="{x:Bind IsStarBadgeVisible, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind StarBadgeText, Mode=OneWay}"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Edge fade over the outer 60px. Against a pure-black band a black-to-transparent
                 gradient is exactly the handoff's linear mask, with no opacity-mask plumbing.
                 IsHitTestVisible=False so it never eats a drag or a click on a thumbnail. -->
            <Rectangle Width="60" HorizontalAlignment="Left" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#FF000000"/>
                        <GradientStop Offset="1" Color="#00000000"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="60" HorizontalAlignment="Right" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#00000000"/>
                        <GradientStop Offset="1" Color="#FF000000"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Grid>
</UserControl>
