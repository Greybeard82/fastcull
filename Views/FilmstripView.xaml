<UserControl
    x:Class="Fastcull.Views.FilmstripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fastcull.Views"
    xmlns:vm="using:Fastcull.ViewModels"
    xmlns:conv="using:Fastcull.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    Loaded="FilmstripView_Loaded"
    KeyDown="FilmstripView_KeyDown">

    <UserControl.Resources>
        <conv:BoolToAccentBrushConverter x:Key="ActiveToBrushConverter"/>
        <conv:ThumbnailFailedToVisibilityConverter x:Key="ThumbnailFailedToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- TOP REGION: exactly 3 slots - previous / active / next, always the true
             neighbors of ActiveIndex in the sorted sequence. -->
        <Grid Grid.Row="0" Margin="24" ColumnDefinitions="1*,2*,1*" ColumnSpacing="16">

            <Border Grid.Column="0" Tapped="PreviousSlot_Tapped" Opacity="0.55"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Image Source="{x:Bind ViewModel.PreviousItem.Thumbnail, Mode=OneWay}" Stretch="Uniform"/>
                    <TextBlock Text="&#x26A0;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind ViewModel.PreviousItem, Mode=OneWay, Converter={StaticResource ThumbnailFailedToVisibilityConverter}}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" Margin="12">
                        <TextBlock Text="{x:Bind ViewModel.PreviousItem.FileName, Mode=OneWay}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ViewModel.PreviousItem.FormatLabel, Mode=OneWay}"
                                   FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="3" CornerRadius="6">
                <Grid>
                    <Image Source="{x:Bind ViewModel.ActiveItem.Thumbnail, Mode=OneWay}" Stretch="Uniform"/>
                    <TextBlock Text="&#x26A0;" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind ViewModel.ActiveItem, Mode=OneWay, Converter={StaticResource ThumbnailFailedToVisibilityConverter}}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="16">
                        <TextBlock Text="{x:Bind ViewModel.ActiveItem.FileName, Mode=OneWay}"
                                   FontSize="18" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveItem.FormatLabel, Mode=OneWay}"
                                   FontSize="13" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Tapped="NextSlot_Tapped" Opacity="0.55"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Image Source="{x:Bind ViewModel.NextItem.Thumbnail, Mode=OneWay}" Stretch="Uniform"/>
                    <TextBlock Text="&#x26A0;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind ViewModel.NextItem, Mode=OneWay, Converter={StaticResource ThumbnailFailedToVisibilityConverter}}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" Margin="12">
                        <TextBlock Text="{x:Bind ViewModel.NextItem.FileName, Mode=OneWay}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ViewModel.NextItem.FormatLabel, Mode=OneWay}"
                                   FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM REGION: every scanned item, independently scrollable by wheel or drag.
             Never moves the top selection on scroll; only a click here changes it. -->
        <ScrollViewer x:Name="BottomScroll" Grid.Row="1" Height="120"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                      ZoomMode="Disabled"
                      PointerWheelChanged="BottomScroll_PointerWheelChanged"
                      PointerPressed="BottomScroll_PointerPressed"
                      PointerMoved="BottomScroll_PointerMoved"
                      PointerReleased="BottomScroll_PointerReleased"
                      PointerCaptureLost="BottomScroll_PointerReleased">
            <ItemsRepeater x:Name="ThumbRepeater" ItemsSource="{x:Bind ViewModel.Items}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilmstripItemViewModel">
                        <Border Width="140" Height="96" Tapped="Thumbnail_Tapped"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="2"
                                BorderBrush="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource ActiveToBrushConverter}}"
                                CornerRadius="4">
                            <Grid>
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"/>
                                <TextBlock Text="&#x26A0;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Visibility="{x:Bind ThumbnailFailed, Mode=OneWay}"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3" Margin="8">
                                    <TextBlock Text="{x:Bind FileName}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind FormatLabel}" FontSize="9"
                                               Opacity="0.65" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
