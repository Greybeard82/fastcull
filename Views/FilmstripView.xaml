<UserControl
    x:Class="Fastcull.Views.FilmstripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fastcull.Views"
    xmlns:vm="using:Fastcull.ViewModels"
    xmlns:conv="using:Fastcull.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    FontFamily="{StaticResource UiFontFamily}"
    Loaded="FilmstripView_Loaded">

    <!--
        The "Chromeless" direction from the Design/ handoff (look 1b): no borders anywhere.
        State reads as a 3px weight bar beneath each photo, active-ness as a thin accent tick
        above it. The photos carry the screen; the interface gets out of the way.

        The concentric red/yellow/green + blue rings that PRD 1.5 describes are deliberately
        gone - that section describes the earlier visual pass, and this handoff is the direction
        that was picked from three explored looks.
    -->
    <UserControl.Resources>
        <conv:ActiveSlotToTickBrushConverter x:Key="TickBrush"/>
        <conv:ActiveSlotToCaptionBrushConverter x:Key="CaptionBrush"/>
        <conv:CullStateToWeightBarBrushConverter x:Key="WeightBrush"/>
        <conv:ThumbnailMarkBrushConverter x:Key="ThumbMark"/>
        <conv:BoolToThumbnailOpacityConverter x:Key="ThumbOpacity"/>
        <conv:ItemToVisibilityConverter x:Key="ItemVisible"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto" Background="{StaticResource GroundBrush}">

        <!-- ================================ STAGE ================================
             Three consecutive photos (PRD 1.5), the active one centred except at the
             sequence ends. Padding and gap are the handoff's literal values. -->
        <!-- StageHost owns the available space; Stage sizes to its content and centres inside it.
             Auto columns are load-bearing: with star columns each slot got a fixed third of the
             stage whether it needed it or not, so a portrait photo sat in a landscape-sized cell
             and the visible gap became cell-width-minus-photo-width - hundreds of pixels - while
             ColumnSpacing sat there saying 5. Auto columns take exactly the frame width ApplySlot
             assigns, which makes the gap literally the gap. -->
        <Border x:Name="StageHost" Grid.Row="0" Padding="{StaticResource StagePadding}"
                SizeChanged="StageHost_SizeChanged">
            <Grid x:Name="Stage" ColumnDefinitions="Auto,Auto,Auto"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  ColumnSpacing="{StaticResource StageColumnSpacing}">

                <!-- Slot 0 -->
                <StackPanel Grid.Column="0" Tag="0" Tapped="Slot_Tapped" Spacing="12" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.Slot0Item, Mode=OneWay, Converter={StaticResource ItemVisible}}">
                    <Border x:Name="Slot0Tick" Height="2" CornerRadius="1" Margin="0,0,0,2"
                            HorizontalAlignment="Center"
                            Background="{x:Bind ViewModel.ActiveSlot, Mode=OneWay, Converter={StaticResource TickBrush}, ConverterParameter=0}"/>
                    <!-- Frame is the POST-rotation layout box; the Image inside is laid out
                         pre-rotation and turned about its centre. See ApplySlot. -->
                    <Grid x:Name="Slot0Frame">
                        <Canvas>
                            <Image x:Name="Slot0Image" Stretch="Uniform"
                                   RenderTransformOrigin="0.5,0.5"
                                   Source="{x:Bind ViewModel.Slot0Item.DisplayImage, Mode=OneWay}">
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="Slot0Rotate"/>
                                </Image.RenderTransform>
                            </Image>
                        </Canvas>
                        <TextBlock Text="&#x26A0;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource RejectBrush}"
                                   Visibility="{x:Bind ViewModel.Slot0Item.DisplayImageFailedVisibility, Mode=OneWay}"/>
                    </Grid>
                    <Border x:Name="Slot0Bar" Height="3" CornerRadius="2" HorizontalAlignment="Center"
                            Background="{x:Bind ViewModel.Slot0Item.CullState, Mode=OneWay, Converter={StaticResource WeightBrush}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Slot0Item.DisplayName, Mode=OneWay}"
                                   FontSize="10" CharacterSpacing="140" TextTrimming="CharacterEllipsis"
                                   Foreground="{x:Bind ViewModel.ActiveSlot, Mode=OneWay, Converter={StaticResource CaptionBrush}, ConverterParameter=0}"/>
                        <TextBlock Text="{x:Bind ViewModel.Slot0Item.StarString, Mode=OneWay}"
                                   FontSize="9" CharacterSpacing="140"
                                   Foreground="{StaticResource Accent400Brush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Slot 1 -->
                <StackPanel Grid.Column="1" Tag="1" Tapped="Slot_Tapped" Spacing="12" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.Slot1Item, Mode=OneWay, Converter={StaticResource ItemVisible}}">
                    <Border x:Name="Slot1Tick" Height="2" CornerRadius="1" Margin="0,0,0,2"
                            HorizontalAlignment="Center"
                            Background="{x:Bind ViewModel.ActiveSlot, Mode=OneWay, Converter={StaticResource TickBrush}, ConverterParameter=1}"/>
                    <Grid x:Name="Slot1Frame">
                        <Canvas>
                            <Image x:Name="Slot1Image" Stretch="Uniform"
                                   RenderTransformOrigin="0.5,0.5"
                                   Source="{x:Bind ViewModel.Slot1Item.DisplayImage, Mode=OneWay}">
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="Slot1Rotate"/>
                                </Image.RenderTransform>
                            </Image>
                        </Canvas>
                        <TextBlock Text="&#x26A0;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource RejectBrush}"
                                   Visibility="{x:Bind ViewModel.Slot1Item.DisplayImageFailedVisibility, Mode=OneWay}"/>
                    </Grid>
                    <Border x:Name="Slot1Bar" Height="3" CornerRadius="2" HorizontalAlignment="Center"
                            Background="{x:Bind ViewModel.Slot1Item.CullState, Mode=OneWay, Converter={StaticResource WeightBrush}}"/>
                    <!-- The caption row stretches to the frame width (the parent StackPanel is
                         centred and sized by its widest child, the photo frame), so the rotate
                         buttons land at the photo's right edge while the name stays centred. -->
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Slot1Item.DisplayName, Mode=OneWay}"
                                       FontSize="10" CharacterSpacing="140" TextTrimming="CharacterEllipsis"
                                       Foreground="{x:Bind ViewModel.ActiveSlot, Mode=OneWay, Converter={StaticResource CaptionBrush}, ConverterParameter=1}"/>
                            <TextBlock Text="{x:Bind ViewModel.Slot1Item.StarString, Mode=OneWay}"
                                       FontSize="9" CharacterSpacing="140"
                                       Foreground="{StaticResource Accent400Brush}"/>
                        </StackPanel>

                        <!-- Rotate controls (PRD 1.11). They sit under the centre slot always,
                             but act on the ACTIVE item - which is a different photo at the
                             sequence boundaries, where the active marker moves to an end slot. -->
                        <StackPanel Orientation="Horizontal" Spacing="2"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Tapped="RotateButtons_Tapped">
                            <Button Style="{StaticResource ChromelessGlyphButtonStyle}"
                                    Content="&#x21BA;" Click="RotateLeft_Click"
                                    AutomationProperties.Name="Rotate left 90 degrees"/>
                            <Button Style="{StaticResource ChromelessGlyphButtonStyle}"
                                    Content="&#x21BB;" Click="RotateRight_Click"
                                    AutomationProperties.Name="Rotate right 90 degrees"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Slot 2 -->
                <StackPanel Grid.Column="2" Tag="2" Tapped="Slot_Tapped" Spacing="12" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.Slot2Item, Mode=OneWay, Converter={StaticResource ItemVisible}}">
                    <Border x:Name="Slot2Tick" Height="2" CornerRadius="1" Margin="0,0,0,2"
                            HorizontalAlignment="Center"
                            Background="{x:Bind ViewModel.ActiveSlot, Mode=OneWay, Converter={StaticResource TickBrush}, ConverterParameter=2}"/>
                    <Grid x:Name="Slot2Frame">
                        <Canvas>
                            <Image x:Name="Slot2Image" Stretch="Uniform"
                                   RenderTransformOrigin="0.5,0.5"
                                   Source="{x:Bind ViewModel.Slot2Item.DisplayImage, Mode=OneWay}">
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="Slot2Rotate"/>
                                </Image.RenderTransform>
                            </Image>
                        </Canvas>
                        <TextBlock Text="&#x26A0;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource RejectBrush}"
                                   Visibility="{x:Bind ViewModel.Slot2Item.DisplayImageFailedVisibility, Mode=OneWay}"/>
                    </Grid>
                    <Border x:Name="Slot2Bar" Height="3" CornerRadius="2" HorizontalAlignment="Center"
                            Background="{x:Bind ViewModel.Slot2Item.CullState, Mode=OneWay, Converter={StaticResource WeightBrush}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Slot2Item.DisplayName, Mode=OneWay}"
                                   FontSize="10" CharacterSpacing="140" TextTrimming="CharacterEllipsis"
                                   Foreground="{x:Bind ViewModel.ActiveSlot, Mode=OneWay, Converter={StaticResource CaptionBrush}, ConverterParameter=2}"/>
                        <TextBlock Text="{x:Bind ViewModel.Slot2Item.StarString, Mode=OneWay}"
                                   FontSize="9" CharacterSpacing="140"
                                   Foreground="{StaticResource Accent400Brush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== FILMSTRIP ==============================
             108px band, one step darker than the window in the handoff - see
             Themes/Nocturne.xaml for why it ships pure black instead. Mouse-only
             (PRD 2.4): it never sees arrow keys, and scrolling here never moves the
             stage selection. Only a click does. -->
        <Grid Grid.Row="1" Height="108" Background="{StaticResource FilmstripBandBrush}"
              BorderThickness="0,1,0,0" BorderBrush="{StaticResource Neutral900Brush}">

            <ScrollViewer x:Name="BottomScroll" Padding="0,8"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                          ZoomMode="Disabled"
                          IsTabStop="False" XYFocusKeyboardNavigation="Disabled"
                          PointerWheelChanged="BottomScroll_PointerWheelChanged"
                          PointerPressed="BottomScroll_PointerPressed"
                          PointerMoved="BottomScroll_PointerMoved"
                          PointerReleased="BottomScroll_PointerReleased"
                          PointerCaptureLost="BottomScroll_PointerReleased">
                <ItemsRepeater x:Name="ThumbRepeater" ItemsSource="{x:Bind ViewModel.Items}" IsTabStop="False"
                               Margin="40,0" VerticalAlignment="Bottom">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="8"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilmstripItemViewModel">
                            <StackPanel Width="150" VerticalAlignment="Bottom"
                                        Tapped="Thumbnail_Tapped" Background="Transparent"
                                        Opacity="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource ThumbOpacity}}">
                                <!-- UniformToFill + a corner-radius Border reproduces the
                                     handoff's background-size: cover crop. -->
                                <!-- The Border is the slot and clips to it. The Image inside is
                                     laid out with width/height swapped on a quarter turn, so
                                     once rotated about its centre its bounding box is exactly
                                     the slot - a rotated thumbnail fills its slot and never
                                     overlaps its neighbours. -->
                                <Border CornerRadius="2" Height="{x:Bind ThumbnailSlotHeight, Mode=OneWay}">
                                    <Grid>
                                        <Canvas>
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                                                   Width="{x:Bind ThumbnailImageWidth, Mode=OneWay}"
                                                   Height="{x:Bind ThumbnailImageHeight, Mode=OneWay}"
                                                   Canvas.Left="{x:Bind ThumbnailImageLeft, Mode=OneWay}"
                                                   Canvas.Top="{x:Bind ThumbnailImageTop, Mode=OneWay}"
                                                   RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <RotateTransform Angle="{x:Bind RotationAngle, Mode=OneWay}"/>
                                                </Image.RenderTransform>
                                            </Image>
                                        </Canvas>
                                        <TextBlock Text="&#x26A0;" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource RejectBrush}"
                                                   Visibility="{x:Bind ThumbnailFailedVisibility, Mode=OneWay}"/>
                                    </Grid>
                                </Border>
                                <!-- The state mark sits below the thumbnail, flush to its own
                                     bottom edge, so it is never clipped by the row. -->
                                <Border Height="2" CornerRadius="1" Margin="0,4,0,0"
                                        Background="{x:Bind CullState, Mode=OneWay, Converter={StaticResource ThumbMark}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Edge fade over the outer 60px. Against a pure-black band a black-to-transparent
                 gradient is exactly the handoff's linear mask, with no opacity-mask plumbing.
                 IsHitTestVisible=False so it never eats a drag or a click on a thumbnail. -->
            <Rectangle Width="60" HorizontalAlignment="Left" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#FF000000"/>
                        <GradientStop Offset="1" Color="#00000000"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="60" HorizontalAlignment="Right" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#00000000"/>
                        <GradientStop Offset="1" Color="#FF000000"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Grid>
</UserControl>
