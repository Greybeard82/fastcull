<UserControl
    x:Class="Fastcull.Views.FilmstripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fastcull.Views"
    xmlns:vm="using:Fastcull.ViewModels"
    xmlns:conv="using:Fastcull.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    Loaded="FilmstripView_Loaded">

    <UserControl.Resources>
        <conv:ActiveSlotToBrushConverter x:Key="ActiveSlotToBrush"/>
        <conv:BoolToActiveRingBrushConverter x:Key="BoolToActiveRing"/>
        <conv:ItemToVisibilityConverter x:Key="ItemVisible"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto" Background="#FF000000">

        <!-- TOP REGION: three consecutive photos (PRD 1.5). The active one is the centre slot
             except at the sequence ends, where the marker moves to an end slot rather than the
             window scrolling past the boundary. Each slot is two concentric borders: the outer
             is the blue active ring, the inner is the state colour, both the same thickness, so
             state and active-ness can never be confused. -->
        <Grid Grid.Row="0" Margin="24" ColumnDefinitions="1*,1*,1*" ColumnSpacing="16">

            <!-- Slot 0 -->
            <Border Grid.Column="0" Tag="0" Tapped="Slot_Tapped" Background="#FF000000"
                    BorderThickness="3"
                    BorderBrush="{x:Bind ViewModel.ActiveSlot, Mode=OneWay, Converter={StaticResource ActiveSlotToBrush}, ConverterParameter=0}">
                <Border BorderThickness="3" BorderBrush="{x:Bind ViewModel.Slot0Item.StateBorderBrush, Mode=OneWay}">
                    <Grid Visibility="{x:Bind ViewModel.Slot0Item, Mode=OneWay, Converter={StaticResource ItemVisible}}">
                        <Image Source="{x:Bind ViewModel.Slot0Item.DisplayImage, Mode=OneWay}" Stretch="Uniform"/>
                        <TextBlock Text="&#x26A0;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FFE81123"
                                   Visibility="{x:Bind ViewModel.Slot0Item.DisplayImageFailedVisibility, Mode=OneWay}"/>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="2" Margin="10">
                            <TextBlock Text="{x:Bind ViewModel.Slot0Item.FileName, Mode=OneWay}"
                                       FontSize="12" Foreground="#FFE0E0E0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewModel.Slot0Item.FormatLabel, Mode=OneWay}"
                                       FontSize="10" Foreground="#FF909090"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                Background="#CC000000" CornerRadius="4" Padding="9,3"
                                Visibility="{x:Bind ViewModel.Slot0Item.IsStarBadgeVisible, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Slot0Item.StarBadgeText, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        </Border>
                    </Grid>
                </Border>
            </Border>

            <!-- Slot 1 -->
            <Border Grid.Column="1" Tag="1" Tapped="Slot_Tapped" Background="#FF000000"
                    BorderThickness="3"
                    BorderBrush="{x:Bind ViewModel.ActiveSlot, Mode=OneWay, Converter={StaticResource ActiveSlotToBrush}, ConverterParameter=1}">
                <Border BorderThickness="3" BorderBrush="{x:Bind ViewModel.Slot1Item.StateBorderBrush, Mode=OneWay}">
                    <Grid Visibility="{x:Bind ViewModel.Slot1Item, Mode=OneWay, Converter={StaticResource ItemVisible}}">
                        <Image Source="{x:Bind ViewModel.Slot1Item.DisplayImage, Mode=OneWay}" Stretch="Uniform"/>
                        <TextBlock Text="&#x26A0;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FFE81123"
                                   Visibility="{x:Bind ViewModel.Slot1Item.DisplayImageFailedVisibility, Mode=OneWay}"/>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="2" Margin="10">
                            <TextBlock Text="{x:Bind ViewModel.Slot1Item.FileName, Mode=OneWay}"
                                       FontSize="12" Foreground="#FFE0E0E0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewModel.Slot1Item.FormatLabel, Mode=OneWay}"
                                       FontSize="10" Foreground="#FF909090"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                Background="#CC000000" CornerRadius="4" Padding="9,3"
                                Visibility="{x:Bind ViewModel.Slot1Item.IsStarBadgeVisible, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Slot1Item.StarBadgeText, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        </Border>
                    </Grid>
                </Border>
            </Border>

            <!-- Slot 2 -->
            <Border Grid.Column="2" Tag="2" Tapped="Slot_Tapped" Background="#FF000000"
                    BorderThickness="3"
                    BorderBrush="{x:Bind ViewModel.ActiveSlot, Mode=OneWay, Converter={StaticResource ActiveSlotToBrush}, ConverterParameter=2}">
                <Border BorderThickness="3" BorderBrush="{x:Bind ViewModel.Slot2Item.StateBorderBrush, Mode=OneWay}">
                    <Grid Visibility="{x:Bind ViewModel.Slot2Item, Mode=OneWay, Converter={StaticResource ItemVisible}}">
                        <Image Source="{x:Bind ViewModel.Slot2Item.DisplayImage, Mode=OneWay}" Stretch="Uniform"/>
                        <TextBlock Text="&#x26A0;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FFE81123"
                                   Visibility="{x:Bind ViewModel.Slot2Item.DisplayImageFailedVisibility, Mode=OneWay}"/>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="2" Margin="10">
                            <TextBlock Text="{x:Bind ViewModel.Slot2Item.FileName, Mode=OneWay}"
                                       FontSize="12" Foreground="#FFE0E0E0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewModel.Slot2Item.FormatLabel, Mode=OneWay}"
                                       FontSize="10" Foreground="#FF909090"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                Background="#CC000000" CornerRadius="4" Padding="9,3"
                                Visibility="{x:Bind ViewModel.Slot2Item.IsStarBadgeVisible, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Slot2Item.StarBadgeText, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- BOTTOM REGION: every scanned item, independently scrollable by wheel or drag.
             Mouse-only (PRD 2.4) - it never sees arrow keys. Scrolling here never moves the top
             selection; only a click does. -->
        <ScrollViewer x:Name="BottomScroll" Grid.Row="1" Height="120" Background="#FF000000"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                      ZoomMode="Disabled"
                      IsTabStop="False" XYFocusKeyboardNavigation="Disabled"
                      PointerWheelChanged="BottomScroll_PointerWheelChanged"
                      PointerPressed="BottomScroll_PointerPressed"
                      PointerMoved="BottomScroll_PointerMoved"
                      PointerReleased="BottomScroll_PointerReleased"
                      PointerCaptureLost="BottomScroll_PointerReleased">
            <ItemsRepeater x:Name="ThumbRepeater" ItemsSource="{x:Bind ViewModel.Items}" IsTabStop="False"
                           Background="#FF000000">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilmstripItemViewModel">
                        <Border Width="140" Height="96" Tapped="Thumbnail_Tapped" Background="#FF000000"
                                BorderThickness="2"
                                BorderBrush="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToActiveRing}}">
                            <Border BorderThickness="2" BorderBrush="{x:Bind StateBorderBrush, Mode=OneWay}">
                                <Grid>
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"/>
                                    <TextBlock Text="&#x26A0;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#FFE81123"
                                               Visibility="{x:Bind ThumbnailFailedVisibility, Mode=OneWay}"/>
                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="1" Margin="4">
                                        <TextBlock Text="{x:Bind FileName}" FontSize="10" Foreground="#FFD0D0D0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind FormatLabel}" FontSize="8" Foreground="#FF808080"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                            Background="#CC000000" CornerRadius="3" Padding="6,1"
                                            Visibility="{x:Bind IsStarBadgeVisible, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind StarBadgeText, Mode=OneWay}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
