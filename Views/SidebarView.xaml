<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fastcull.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fastcull.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource UiFontFamily}">

    <!-- PRD 1.10 is absolute: every non-photograph pixel is exactly #FF000000. The panel is
         separated from the stage by a single hairline rule, not by a lighter fill. -->

    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="CharacterSpacing" Value="140"/>
            <Setter Property="Foreground" Value="{StaticResource Neutral700Brush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="TallyLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CharacterSpacing" Value="50"/>
            <Setter Property="Foreground" Value="{StaticResource Neutral500Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Right-aligned rather than tabular-figured: WinUI's TextBlock has no FontFeatures, so
             pinning the right edge is what stops a count reflowing its row on every keypress. -->
        <Style x:Key="TallyValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Neutral200Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalTextAlignment" Value="Right"/>
        </Style>

        <!-- Active Photo rows: a muted label above a readable value, stacked rather than in
             columns because a place name or a folder path needs the panel's full width. -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="CharacterSpacing" Value="140"/>
            <Setter Property="Foreground" Value="{StaticResource Neutral800Brush}"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Neutral300Brush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxLines" Value="1"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <Style x:Key="StarValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Neutral500Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalTextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF000000">
        <!-- Hairline on the trailing edge, the only thing dividing panel from stage. -->
        <Border BorderBrush="{StaticResource Neutral900Brush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,14,16,16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

                <!-- ================= Folder + pin ================= -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="{x:Bind ViewModel.FolderName, Mode=OneWay}"
                                   FontSize="13" CharacterSpacing="40"
                                   Foreground="{StaticResource Accent200Brush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <TextBlock Text="{x:Bind ViewModel.FolderPath, Mode=OneWay}"
                                   FontSize="9" CharacterSpacing="20"
                                   Foreground="{StaticResource Neutral700Brush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.FolderPath, Mode=OneWay}"/>
                    </StackPanel>

                    <!-- IsTabStop=False: keyboard focus belongs to the cull, never to chrome.
                         RootGrid's PreviewKeyDown already claims every mapped key before a focused
                         child sees it, so this is belt-and-braces rather than the only guard. -->
                    <Button Grid.Column="1" x:Name="PinButton" Click="PinButton_Click"
                            IsTabStop="False"
                            Width="26" Height="26" Padding="0" Margin="8,0,0,0"
                            VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PinTooltip, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.PinGlyph, Mode=OneWay}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{x:Bind ViewModel.PinBrush, Mode=OneWay}"/>
                    </Button>
                </Grid>

                <!-- ================= Counts ================= -->
                <StackPanel Grid.Row="1" Margin="0,22,0,0">
                    <TextBlock Text="SESSION" Style="{StaticResource SectionLabel}"/>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                        <TextBlock Grid.Column="0" Text="Total" Style="{StaticResource TallyLabel}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                                   Style="{StaticResource TallyValue}"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,7">
                        <Rectangle Grid.Column="0" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource PickBrush}" Margin="0,0,9,0"/>
                        <TextBlock Grid.Column="1" Text="Picked" Style="{StaticResource TallyLabel}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PickedText, Mode=OneWay}"
                                   Style="{StaticResource TallyValue}"
                                   Foreground="{StaticResource PickBrush}"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,7">
                        <Rectangle Grid.Column="0" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource RejectBrush}" Margin="0,0,9,0"/>
                        <TextBlock Grid.Column="1" Text="Rejected" Style="{StaticResource TallyLabel}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RejectedText, Mode=OneWay}"
                                   Style="{StaticResource TallyValue}"
                                   Foreground="{StaticResource RejectBrush}"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Rectangle Grid.Column="0" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource Neutral800Brush}" Margin="0,0,9,0"/>
                        <TextBlock Grid.Column="1" Text="Remaining" Style="{StaticResource TallyLabel}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.UnflaggedText, Mode=OneWay}"
                                   Style="{StaticResource TallyValue}"/>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                               FontSize="9" CharacterSpacing="60" Margin="0,12,0,0"
                               Foreground="{StaticResource Neutral700Brush}"/>

                    <!-- PRD 1.2's scan pill. Present only while a scan is running and has run
                         long enough to be worth watching. -->
                    <Border Visibility="{x:Bind ViewModel.ScanPillVisibility, Mode=OneWay}"
                            Margin="0,10,0,0" Padding="8,3" CornerRadius="9"
                            HorizontalAlignment="Left"
                            BorderBrush="{StaticResource Neutral800Brush}" BorderThickness="1">
                        <TextBlock Text="{x:Bind ViewModel.ScanProgressText, Mode=OneWay}"
                                   FontSize="9" CharacterSpacing="60"
                                   Foreground="{StaticResource Accent300Brush}"/>
                    </Border>

                    <!-- Format breakdown (PRD 1.5). One row per extension rather than per family:
                         .ARW and .CR2 are both "Raw", and telling a mixed two-body card apart is
                         the whole point of the section. -->
                    <TextBlock Text="FORMATS" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"
                               Visibility="{x:Bind ViewModel.FormatsVisibility, Mode=OneWay}"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Formats, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FormatRowViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}" Width="46"
                                               FontSize="9" CharacterSpacing="80"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Neutral400Brush}"/>
                                    <Rectangle Grid.Column="1" Height="4" RadiusX="2" RadiusY="2"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Fill="{StaticResource Neutral600Brush}"
                                               Width="{x:Bind BarWidth}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText}" Width="28"
                                               FontSize="10" VerticalAlignment="Center"
                                               HorizontalTextAlignment="Right"
                                               Foreground="{StaticResource Neutral500Brush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- ================= Active Photo (PRD 1.5) =================
                     Every row hides itself when its field is absent, per PRD 1.5 - a panel showing
                     "Device: —" for half a folder is worse than one showing four rows. Bound
                     straight through to the active item so the on-photo overlay (§1.8.1) and this
                     panel can never disagree. -->
                <StackPanel Grid.Row="2" Margin="0,26,0,0"
                            Visibility="{x:Bind ViewModel.ActivePhotoVisibility, Mode=OneWay}">
                    <TextBlock Text="ACTIVE PHOTO" Style="{StaticResource SectionLabel}"/>

                    <StackPanel Margin="0,0,0,9"
                                Visibility="{x:Bind ViewModel.ActivePhoto.DeviceVisibility, Mode=OneWay}">
                        <TextBlock Text="DEVICE" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{x:Bind ViewModel.ActivePhoto.DeviceText, Mode=OneWay}"
                                   Style="{StaticResource InfoValue}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,9"
                                Visibility="{x:Bind ViewModel.ActivePhoto.ResolutionVisibility, Mode=OneWay}">
                        <TextBlock Text="RESOLUTION" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{x:Bind ViewModel.ActivePhoto.ResolutionText, Mode=OneWay}"
                                   Style="{StaticResource InfoValue}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,9"
                                Visibility="{x:Bind ViewModel.ActivePhoto.CapturedVisibility, Mode=OneWay}">
                        <TextBlock Text="CAPTURED" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{x:Bind ViewModel.ActivePhoto.CapturedText, Mode=OneWay}"
                                   Style="{StaticResource InfoValue}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,9"
                                Visibility="{x:Bind ViewModel.ActivePhoto.PlaceVisibility, Mode=OneWay}">
                        <TextBlock Text="PLACE" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{x:Bind ViewModel.ActivePhoto.PlaceText, Mode=OneWay}"
                                   Style="{StaticResource InfoValue}"/>
                    </StackPanel>

                    <!-- The exposure triplet, reading the same properties the on-photo overlay
                         does (PRD 1.5's field table is the single list). No Visibility bindings:
                         these three always render, with "-" when absent - PRD 1.8.1's deliberate
                         exception to omit-if-missing. -->
                    <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,9">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FOCAL" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{x:Bind ViewModel.ActivePhoto.FocalLengthText, Mode=OneWay}"
                                       Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SHUTTER" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{x:Bind ViewModel.ActivePhoto.ShutterSpeedText, Mode=OneWay}"
                                       Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="APERTURE" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{x:Bind ViewModel.ActivePhoto.ApertureText, Mode=OneWay}"
                                       Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{x:Bind ViewModel.ActivePhoto.FolderVisibility, Mode=OneWay}">
                        <TextBlock Text="FOLDER" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{x:Bind ViewModel.ActivePhoto.FolderText, Mode=OneWay}"
                                   Style="{StaticResource InfoValue}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.ActivePhoto.FolderText, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ================= Star histogram ================= -->
                <StackPanel Grid.Row="3" Margin="0,26,0,0">
                    <TextBlock Text="STARS" Style="{StaticResource SectionLabel}"/>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="★" FontSize="9"
                                   Foreground="{StaticResource Accent400Brush}"
                                   VerticalAlignment="Center" Width="46"/>
                        <Rectangle Grid.Column="1" Height="4" RadiusX="2" RadiusY="2"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{StaticResource Accent400Brush}"
                                   Width="{x:Bind ViewModel.Star1BarWidth, Mode=OneWay}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Star1Text, Mode=OneWay}"
                                   Style="{StaticResource StarValue}" Width="28"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="★★" FontSize="9"
                                   Foreground="{StaticResource Accent400Brush}"
                                   VerticalAlignment="Center" Width="46"/>
                        <Rectangle Grid.Column="1" Height="4" RadiusX="2" RadiusY="2"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{StaticResource Accent400Brush}"
                                   Width="{x:Bind ViewModel.Star2BarWidth, Mode=OneWay}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Star2Text, Mode=OneWay}"
                                   Style="{StaticResource StarValue}" Width="28"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="★★★" FontSize="9"
                                   Foreground="{StaticResource Accent400Brush}"
                                   VerticalAlignment="Center" Width="46"/>
                        <Rectangle Grid.Column="1" Height="4" RadiusX="2" RadiusY="2"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{StaticResource Accent400Brush}"
                                   Width="{x:Bind ViewModel.Star3BarWidth, Mode=OneWay}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Star3Text, Mode=OneWay}"
                                   Style="{StaticResource StarValue}" Width="28"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="★★★★" FontSize="9"
                                   Foreground="{StaticResource Accent400Brush}"
                                   VerticalAlignment="Center" Width="46"/>
                        <Rectangle Grid.Column="1" Height="4" RadiusX="2" RadiusY="2"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{StaticResource Accent400Brush}"
                                   Width="{x:Bind ViewModel.Star4BarWidth, Mode=OneWay}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Star4Text, Mode=OneWay}"
                                   Style="{StaticResource StarValue}" Width="28"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="★★★★★" FontSize="9"
                                   Foreground="{StaticResource Accent400Brush}"
                                   VerticalAlignment="Center" Width="46"/>
                        <Rectangle Grid.Column="1" Height="4" RadiusX="2" RadiusY="2"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{StaticResource Accent400Brush}"
                                   Width="{x:Bind ViewModel.Star5BarWidth, Mode=OneWay}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Star5Text, Mode=OneWay}"
                                   Style="{StaticResource StarValue}" Width="28"/>
                    </Grid>
                </StackPanel>

                <!-- ================= Folder tree (PRD 1.5) =================
                     A flat, indented list rather than a WinUI TreeView: TreeView carries its own
                     selection and hover brushes that would each have to be beaten back to black
                     for PRD 1.10, and an indent plus a chevron is all the control was going to
                     give us here.

                     Clicking a folder MOVES THE CURSOR to its first photo; it does not filter the
                     sequence. See the run report for why. The section hides itself entirely when
                     the scanned folder is flat, since a tree of one node is just noise. -->
                <StackPanel Grid.Row="4" Margin="0,26,0,0"
                            Visibility="{x:Bind ViewModel.FolderTreeVisibility, Mode=OneWay}">
                    <TextBlock Text="FOLDERS" Style="{StaticResource SectionLabel}"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FolderRows, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="1"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderRowViewModel">
                                <!-- Tag carries the row's own view-model. ItemsRepeater does not
                                     propagate DataContext into a template, so a handler reading
                                     sender.DataContext gets null - this project has been caught by
                                     that once already, in the filmstrip. x:Bind with no path
                                     resolves to the item itself, which is exactly what is wanted. -->
                                <Grid Margin="{x:Bind Indent}" ColumnDefinitions="Auto,*,Auto"
                                      Background="Transparent"
                                      Tag="{x:Bind}"
                                      Tapped="FolderRow_Tapped"
                                      Height="22">
                                    <!-- Tapped, not Click: a Button's Click does not stop Tapped
                                         bubbling to the row underneath, so using Click meant
                                         opening a folder ALSO navigated into it. Handling Tapped
                                         and marking it handled is what keeps the two separate -
                                         the same trick the stage's rotate buttons use. -->
                                    <Button Grid.Column="0" Width="16" Height="16" Padding="0"
                                            IsTabStop="False"
                                            Background="Transparent" BorderThickness="0"
                                            Visibility="{x:Bind ChevronVisibility}"
                                            Tag="{x:Bind}"
                                            Tapped="FolderChevron_Tapped">
                                        <TextBlock Text="{x:Bind ChevronGlyph, Mode=OneWay}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="8"
                                                   Foreground="{StaticResource Neutral700Brush}"/>
                                    </Button>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                               Margin="4,0,0,0"
                                               FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Foreground="{x:Bind NameBrush, Mode=OneWay}"/>

                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText}"
                                               FontSize="9" VerticalAlignment="Center"
                                               Foreground="{StaticResource Neutral700Brush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- ================= Finish Session placeholder =================
                     Disabled on purpose. PRD 4.1's modal and the entire batch copy/move path do
                     not exist in the codebase; a button that looked live would be a lie.

                     The tooltip sits on the wrapping Grid, not on the Button: a disabled control
                     receives no pointer input in WinUI, so a tooltip set on the Button itself
                     would never appear. -->
                <Grid Grid.Row="6" ToolTipService.ToolTip="Coming soon — batch export is not built yet">
                    <Button IsEnabled="False"
                            HorizontalAlignment="Stretch" Height="30"
                            Background="Transparent"
                            BorderBrush="{StaticResource Neutral900Brush}" BorderThickness="1">
                        <TextBlock Text="FINISH SESSION" FontSize="9" CharacterSpacing="140"
                                   Foreground="{StaticResource Neutral800Brush}"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
