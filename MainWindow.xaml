<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fastcull.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fastcull"
    xmlns:views="using:Fastcull.Views"
    xmlns:conv="using:Fastcull.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fastcull">

    <!-- No SystemBackdrop: Mica and Acrylic both tint with the desktop wallpaper and can never
         be fully black, which PRD 1.10 requires. -->

    <Grid x:Name="RootGrid" Background="#FF000000" RowDefinitions="Auto,*"
          PreviewKeyDown="RootGrid_PreviewKeyDown">

        <!-- Auto rather than a fixed 30: collapsing the title bar for fullscreen has to give its
             height back to the stage, which a fixed row would not do. The converter lives in
             App.xaml because a Window is not a FrameworkElement and cannot host a resource scope
             its own x:Bind expressions can resolve against. -->

        <!-- Title bar (Design/ handoff): wordmark left, session position counter right, then the
             system caption buttons. Content is extended into the title bar in code-behind so the
             whole strip can be pure black; TitleBarDragRegion is handed to SetTitleBar there so
             the window still drags. RightInset reserves room for the caption buttons and is set
             at runtime, since its width is system- and DPI-dependent. -->
        <!-- Visibility is set from code-behind rather than bound: a converter binding inside a
             Window does not compile, because the generated x:Bind code wants a FrameworkElement
             scope and a Window is not one. -->
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Height="30" Background="#FF000000" Padding="11.2,0,5.6,0">
            <TextBlock Text="FASTCULL" FontSize="10" CharacterSpacing="120"
                       FontFamily="{StaticResource UiFontFamily}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Foreground="{StaticResource Neutral700Brush}"/>
            <TextBlock x:Name="PositionCounter" FontSize="10" CharacterSpacing="80"
                       FontFamily="{StaticResource UiFontFamily}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{StaticResource Neutral700Brush}"
                       Text="{x:Bind Filmstrip.ViewModel.PositionText, Mode=OneWay}"/>
        </Grid>

        <views:FilmstripView x:Name="Filmstrip" Grid.Row="1"/>
    </Grid>
</Window>
