<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fastcull.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fastcull"
    xmlns:views="using:Fastcull.Views"
    xmlns:conv="using:Fastcull.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fastcull">

    <!-- No SystemBackdrop: Mica and Acrylic both tint with the desktop wallpaper and can never
         be fully black, which PRD 1.10 requires. -->

    <Grid x:Name="RootGrid" Background="#FF000000" RowDefinitions="Auto,*"
          PreviewKeyDown="RootGrid_PreviewKeyDown">

        <!-- Auto rather than a fixed 30: collapsing the title bar for fullscreen has to give its
             height back to the stage, which a fixed row would not do. The converter lives in
             App.xaml because a Window is not a FrameworkElement and cannot host a resource scope
             its own x:Bind expressions can resolve against. -->

        <!-- Title bar (Design/ handoff): wordmark left, session position counter right, then the
             system caption buttons. Content is extended into the title bar in code-behind so the
             whole strip can be pure black; TitleBarDragRegion is handed to SetTitleBar there so
             the window still drags. RightInset reserves room for the caption buttons and is set
             at runtime, since its width is system- and DPI-dependent. -->
        <!-- Visibility is set from code-behind rather than bound: a converter binding inside a
             Window does not compile, because the generated x:Bind code wants a FrameworkElement
             scope and a Window is not one. -->
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Height="30" Background="#FF000000" Padding="11.2,0,5.6,0">
            <TextBlock Text="FASTCULL" FontSize="10" CharacterSpacing="120"
                       FontFamily="{StaticResource UiFontFamily}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Foreground="{StaticResource Neutral700Brush}"/>
            <TextBlock x:Name="PositionCounter" FontSize="10" CharacterSpacing="80"
                       FontFamily="{StaticResource UiFontFamily}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{StaticResource Neutral700Brush}"
                       Text="{x:Bind Filmstrip.ViewModel.PositionText, Mode=OneWay}"/>
        </Grid>

        <!-- Stage row. Two columns so the sidebar can either overlay the stage or take a gutter
             out of it, without the stage needing to know which is happening: it simply gets a
             narrower column and its existing SizeChanged reflow does the rest.

             Nothing here is x:Bind-ed. A Window is not a FrameworkElement, and binding through it
             has already cost this project once (the title-bar converter); the sidebar's own
             internal bindings live inside the UserControl where x:Bind behaves normally, and the
             two layout reactions are wired explicitly in code-behind. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!-- Zero-width when unpinned, so the panel overlays and no photo resizes just because
                 the pointer drifted to the left edge. PanelWidth when pinned, so the stage
                 reflows and the panel never covers a photo. -->
            <Border x:Name="SidebarGutter" Grid.Column="0" Width="0" Background="#FF000000"/>

            <views:FilmstripView x:Name="Filmstrip" Grid.Column="1"/>

            <!-- Spans both columns and hugs the left edge: with a zero gutter it floats over the
                 stage, with a full gutter it lands exactly inside it. -->
            <!-- Background="Transparent" is load-bearing, not decoration: a panel with no
                 Background is not hit-testable in WinUI, so neither PointerEntered nor
                 PointerExited would ever fire and the sidebar could never reveal. -->
            <Grid x:Name="SidebarHost" Grid.Column="0" Grid.ColumnSpan="2"
                  HorizontalAlignment="Left"
                  Background="Transparent"
                  PointerEntered="SidebarHost_PointerEntered"
                  PointerExited="SidebarHost_PointerExited">

                <!-- Holds the host open at the hot-zone width while the panel is collapsed, so
                     there is always something to hover. -->
                <Border x:Name="SidebarHotZone" Width="12" HorizontalAlignment="Left"
                        Background="Transparent"/>

                <views:SidebarView x:Name="SidebarPanel" Visibility="Collapsed"/>
            </Grid>

            <!-- Keybinding help (PRD 2.1.3). Spans both columns and sits above the sidebar so it
                 is never half-covered by a pinned panel. It is non-blocking - the control itself
                 sets IsHitTestVisible="False" - so everything underneath keeps taking input while
                 it is open. -->
            <views:HelpOverlayView x:Name="HelpOverlay" Grid.Column="0" Grid.ColumnSpan="2"
                                   Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
